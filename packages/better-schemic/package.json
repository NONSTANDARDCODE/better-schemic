{
  "name": "better-schemic",
  "version": "0.1.0-beta.3",
  "description": "Better-schemic — schema-as-code for SurrealDB. Author your schema in TypeScript, generate SurrealQL DDL, and manage migrations.",
  "license": "MIT",
  "author": "NONSTANDARDCODE",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "packages/better-schemic"
  },
  "type": "module",
  "bin": {
    "better-schemic": "lib/cli/index.js",
    "sc": "lib/cli/index.js"
  },
  "sideEffects": [
    "./src/driver.ts",
    "./src/surreal/driver.ts",
    "./src/surreal/driver/surreal.ts",
    "./lib/driver.js"
  ],
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./driver": {
      "bun": "./src/driver.ts",
      "import": {
        "types": "./lib/driver.d.ts",
        "default": "./lib/driver.js"
      }
    },
    "./connection": {
      "bun": "./src/connection.ts",
      "import": {
        "types": "./lib/connection.d.ts",
        "default": "./lib/connection.js"
      }
    },
    "./query": {
      "bun": "./src/query.ts",
      "import": {
        "types": "./lib/query.d.ts",
        "default": "./lib/query.js"
      }
    },
    "./logger": {
      "bun": "./src/logger.ts",
      "import": {
        "types": "./lib/logger.d.ts",
        "default": "./lib/logger.js"
      }
    },
    "./orm": {
      "bun": "./src/orm/index.ts",
      "import": {
        "types": "./lib/orm/index.d.ts",
        "default": "./lib/orm/index.js"
      }
    },
    "./plugins/rules": {
      "bun": "./src/plugins/rules.ts",
      "import": {
        "types": "./lib/plugins/rules.d.ts",
        "default": "./lib/plugins/rules.js"
      }
    },
    "./plugins/zod": {
      "bun": "./src/plugins/zod.ts",
      "import": {
        "types": "./lib/plugins/zod.d.ts",
        "default": "./lib/plugins/zod.js"
      }
    },
    "./plugins/timestamps": {
      "bun": "./src/plugins/timestamps.ts",
      "import": {
        "types": "./lib/plugins/timestamps.d.ts",
        "default": "./lib/plugins/timestamps.js"
      }
    },
    "./plugins/soft-delete": {
      "bun": "./src/plugins/soft-delete.ts",
      "import": {
        "types": "./lib/plugins/soft-delete.d.ts",
        "default": "./lib/plugins/soft-delete.js"
      }
    },
    "./plugins/hard-delete": {
      "bun": "./src/plugins/hard-delete.ts",
      "import": {
        "types": "./lib/plugins/hard-delete.d.ts",
        "default": "./lib/plugins/hard-delete.js"
      }
    },
    "./plugins/create-only": {
      "bun": "./src/plugins/create-only.ts",
      "import": {
        "types": "./lib/plugins/create-only.d.ts",
        "default": "./lib/plugins/create-only.js"
      }
    },
    "./plugins/tenant": {
      "bun": "./src/plugins/tenant.ts",
      "import": {
        "types": "./lib/plugins/tenant.d.ts",
        "default": "./lib/plugins/tenant.js"
      }
    },
    "./config": {
      "bun": "./src/config.ts",
      "import": {
        "types": "./lib/config.d.ts",
        "default": "./lib/config.js"
      }
    },
    "./core": {
      "bun": "./src/core/index.ts",
      "import": {
        "types": "./lib/core/index.d.ts",
        "default": "./lib/core/index.js"
      }
    },
    "./core/driver": {
      "bun": "./src/core/driver/sdk.ts",
      "import": {
        "types": "./lib/core/driver/sdk.d.ts",
        "default": "./lib/core/driver/sdk.js"
      }
    },
    "./authoring": {
      "bun": "./src/authoring.ts",
      "import": {
        "types": "./lib/authoring.d.ts",
        "default": "./lib/authoring.js"
      }
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "import": {
        "types": "./lib/testing.d.ts",
        "default": "./lib/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "test:unit": "bun test test/core/unit test/cli/unit test/surreal/unit",
    "test:live": "bun test test/surreal/live",
    "test:e2e": "bun test test/surreal/e2e",
    "test:types": "bun run ../../scripts/type-bench.ts packages/better-schemic",
    "typecheck": "bun check",
    "lint": "biome check ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "magicast": "^0.5.5",
    "surrealdb": "^2.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@surrealdb/node": "*"
  },
  "peerDependenciesMeta": {
    "@surrealdb/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
