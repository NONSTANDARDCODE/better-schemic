{
  "name": "@better-schemic/cli",
  "version": "0.1.0-alpha.13",
  "description": "The Better-schemic CLI — driver-agnostic schema migrations (gen/migrate/diff/push/pull/check).",
  "license": "MIT",
  "author": "NONSTANDARDCODE",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "better-schemic": "lib/cli/index.js",
    "sc": "lib/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "biome check ."
  },
  "dependencies": {
    "@better-schemic/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@better-schemic/surrealdb": "workspace:*",
    "@types/bun": "^1.4.3",
    "surrealdb": "^2.0.3",
    "zod": "^4.6.7"
  }
}
