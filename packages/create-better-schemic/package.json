{
  "name": "create-better-schemic",
  "version": "0.1.0-alpha.2",
  "description": "Scaffold a new Better-schemic project — package.json, tsconfig, a driver, and the database/ schema, in one command.",
  "license": "MIT",
  "author": "Vertio Solutions",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "packages/create-better-schemic"
  },
  "type": "module",
  "bin": {
    "create-better-schemic": "lib/index.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "typecheck:legacy": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@clack/prompts": "^1.6.0",
    "@types/bun": "latest",
    "tsup": "^8",
    "typescript": "^6.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
