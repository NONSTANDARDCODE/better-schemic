{
  "name": "@better-schemic/core",
  "version": "0.1.0-alpha.10",
  "description": "The dialect-neutral engine for Better-schemic — Driver contract, portable schema IR, and the migration/diff/snapshot engine.",
  "license": "MIT",
  "author": "Vertio Solutions",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./config": {
      "bun": "./src/config.ts",
      "import": {
        "types": "./lib/config.d.ts",
        "default": "./lib/config.js"
      }
    },
    "./driver": {
      "bun": "./src/driver/sdk.ts",
      "import": {
        "types": "./lib/driver/sdk.d.ts",
        "default": "./lib/driver/sdk.js"
      }
    },
    "./authoring": {
      "bun": "./src/authoring.ts",
      "import": {
        "types": "./lib/authoring.d.ts",
        "default": "./lib/authoring.js"
      }
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "import": {
        "types": "./lib/testing.d.ts",
        "default": "./lib/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:live": "bun test test/live",
    "test:e2e": "bun test test/e2e",
    "test:types": "bun run ../../scripts/type-bench.ts packages/core",
    "typecheck": "bun check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "commander": "^14.0.2",
    "jiti": "^2.4.2",
    "magicast": "^0.5.3"
  },
  "peerDependencies": {
    "surrealdb": "^2.0.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "surrealdb": "^2.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "zod": "^4.3.5"
  }
}
