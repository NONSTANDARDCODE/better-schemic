{
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    "group:allNonMajor"
  ],
  "enabledManagers": ["bun", "github-actions"],
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "rangeStrategy": "bump"
    }
  ]
}