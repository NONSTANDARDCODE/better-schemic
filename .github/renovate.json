{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "security:minimumReleaseAgeNpm"],
  "enabledManagers": ["bun", "github-actions"],
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "rangeStrategy": "bump"
    }
  ]
}
