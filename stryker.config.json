{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "bun",
  "plugins": ["./scripts/mutation/bun-runner.ts"],
  "mutate": [
    "packages/better-schemic/src/surreal/orm/compiler/shared.ts",
    "packages/better-schemic/src/surreal/orm/compiler/where.ts",
    "packages/better-schemic/src/surreal/orm/compiler/select.ts",
    "packages/better-schemic/src/surreal/orm/compiler/projection.ts",
    "packages/better-schemic/src/surreal/orm/compiler/aggregate.ts",
    "packages/better-schemic/src/surreal/orm/compiler/pagination.ts",
    "packages/better-schemic/src/surreal/orm/compiler/unique.ts",
    "packages/better-schemic/src/surreal/orm/compiler/relations.ts",
    "packages/better-schemic/src/surreal/orm/compiler/include/*.ts",
    "packages/better-schemic/src/surreal/surql-type-expr.ts",
    "packages/better-schemic/src/surreal/driver/surql-type.ts",
    "packages/better-schemic/src/core/cli-kit/filter.ts"
  ],
  "coverageAnalysis": "off",
  "disableTypeChecks": false,
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": {
    "fileName": ".mutation/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "maxTestRunnerReuse": 0,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignorePatterns": [
    "node_modules",
    ".git",
    ".coverage",
    "coverage",
    ".mutation",
    ".stryker-tmp",
    "lib",
    "dist",
    "*.tgz"
  ]
}
