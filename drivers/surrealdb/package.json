{
  "name": "@better-schemic/surrealdb",
  "version": "0.1.0-alpha.24",
  "description": "SurrealDB driver + authoring for Better-schemic — s.* schema definition, SurrealQL DDL, introspection, migrations.",
  "license": "MIT",
  "author": "Vertio Solutions",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "drivers/surrealdb"
  },
  "type": "module",
  "sideEffects": [
    "./src/driver.ts",
    "./src/driver/surreal.ts",
    "./lib/driver.js"
  ],
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./driver": {
      "bun": "./src/driver.ts",
      "import": {
        "types": "./lib/driver.d.ts",
        "default": "./lib/driver.js"
      }
    },
    "./connection": {
      "bun": "./src/connection.ts",
      "import": {
        "types": "./lib/connection.d.ts",
        "default": "./lib/connection.js"
      }
    },
    "./query": {
      "bun": "./src/query.ts",
      "import": {
        "types": "./lib/query.d.ts",
        "default": "./lib/query.js"
      }
    },
    "./client": {
      "bun": "./src/client.ts",
      "import": {
        "types": "./lib/client.d.ts",
        "default": "./lib/client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "test": "bun test",
    "test:types": "bun run ../../scripts/type-perf.ts drivers/surrealdb",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@better-schemic/core": "workspace:*"
  },
  "peerDependencies": {
    "@surrealdb/node": "*",
    "zod": "^4.3.5",
    "surrealdb": "^2.0.3"
  },
  "peerDependenciesMeta": {
    "@surrealdb/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ark/attest": "0.56.3",
    "@biomejs/biome": "^2.3.11",
    "@better-schemic/cli": "workspace:*",
    "@types/bun": "latest",
    "surrealdb": "^2.0.3",
    "tsup": "^8",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "zod": "^4.3.5"
  }
}
