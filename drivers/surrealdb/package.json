{
  "name": "@better-schemic/surrealdb",
  "version": "0.1.0-alpha.2",
  "description": "SurrealDB driver + authoring for Better-schemic — s.* schema definition, SurrealQL DDL, introspection, migrations.",
  "license": "MIT",
  "author": "Vertio Solutions",
  "homepage": "https://github.com/NONSTANDARDCODE/better-schemic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONSTANDARDCODE/better-schemic.git",
    "directory": "drivers/surrealdb"
  },
  "type": "module",
  "sideEffects": [
    "./src/driver.ts",
    "./src/driver/surreal.ts",
    "./lib/driver.js"
  ],
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./driver": {
      "bun": "./src/driver.ts",
      "import": {
        "types": "./lib/driver.d.ts",
        "default": "./lib/driver.js"
      }
    },
    "./connection": {
      "bun": "./src/connection.ts",
      "import": {
        "types": "./lib/connection.d.ts",
        "default": "./lib/connection.js"
      }
    },
    "./query": {
      "bun": "./src/query.ts",
      "import": {
        "types": "./lib/query.d.ts",
        "default": "./lib/query.js"
      }
    },
    "./logger": {
      "bun": "./src/logger.ts",
      "import": {
        "types": "./lib/logger.d.ts",
        "default": "./lib/logger.js"
      }
    },
    "./orm": {
      "bun": "./src/orm/index.ts",
      "import": {
        "types": "./lib/orm/index.d.ts",
        "default": "./lib/orm/index.js"
      }
    },
    "./plugins/rules": {
      "bun": "./src/plugins/rules.ts",
      "import": {
        "types": "./lib/plugins/rules.d.ts",
        "default": "./lib/plugins/rules.js"
      }
    },
    "./plugins/zod": {
      "bun": "./src/plugins/zod.ts",
      "import": {
        "types": "./lib/plugins/zod.d.ts",
        "default": "./lib/plugins/zod.js"
      }
    },
    "./plugins/timestamps": {
      "bun": "./src/plugins/timestamps.ts",
      "import": {
        "types": "./lib/plugins/timestamps.d.ts",
        "default": "./lib/plugins/timestamps.js"
      }
    },
    "./plugins/soft-delete": {
      "bun": "./src/plugins/soft-delete.ts",
      "import": {
        "types": "./lib/plugins/soft-delete.d.ts",
        "default": "./lib/plugins/soft-delete.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "test:types": "bun run ../../scripts/type-perf.ts drivers/surrealdb",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "typecheck:legacy": "tsc --noEmit"
  },
  "dependencies": {
    "@better-schemic/core": "workspace:*"
  },
  "peerDependencies": {
    "@surrealdb/node": "*",
    "zod": "^4.3.5",
    "surrealdb": "^2.0.3"
  },
  "peerDependenciesMeta": {
    "@surrealdb/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ark/attest": "0.56.3",
    "@biomejs/biome": "^2.3.11",
    "@better-schemic/cli": "workspace:*",
    "@types/bun": "latest",
    "surrealdb": "^2.0.3",
    "tsup": "^8",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "zod": "^4.3.5"
  }
}
